# Canonical production origin. Keep the link origin stable after printing codes.
NEXT_PUBLIC_SITE_URL=https://qrcode.sritejam.com
NEXT_PUBLIC_LINK_BASE_URL=https://qrcode.sritejam.com

# Production signing key: generate 32 random bytes and save it securely.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never change/delete a key used by printed codes. See README for rotation.
TOKEN_SECRET=
TOKEN_ACTIVE_KEY_ID=0

# Turso free database. Only anonymous total and daily counters are stored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local testing only; counts reset when the server restarts.
# COUNT_STORE=memory

# Required for authenticated production pruning.
CRON_SECRET=

# Optional: comma-separated count IDs of disabled abusive links.
BLOCKED_COUNT_IDS=

# Optional. Leave empty to make no Google Safe Browsing requests.
SAFE_BROWSING_API_KEY=

# Optional public contact channels. No placeholder addresses are displayed.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
